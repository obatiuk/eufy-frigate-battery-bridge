{
  "name": "eufy-frigate-battery-bridge",
  "version": "0.0.2",
  "private": true,
  "description": "Event-driven Eufy battery camera and doorbell RTSP/P2P/backfill bridge for Frigate and go2rtc",
  "license": "MIT",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=./test/reporter.js test/*.test.js"
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/ws": "8.18.0",
    "eslint": "9.39.5",
    "knip": "5.85.0",
    "prettier": "3.9.10",
    "typescript": "5.8.2"
  },
  "knip": {
    "entry": [
      "test/*.js",
      "scripts/*.js"
    ],
    "project": [
      "src/**/*.js",
      "test/**/*.js",
      "scripts/**/*.js"
    ],
    "ignoreDependencies": [
      "eslint",
      "prettier"
    ]
  },
  "prettier": {
    "proseWrap": "preserve",
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": false,
    "trailingComma": "es5"
  }
}
